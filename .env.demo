# Loaded only by `npm run play:demo` (vite --mode demo).
#
# The one switch the demo needs: it replaces the game rather than joining it, so the mode is the
# whole difference between `play:local` and `play:demo`. Nobody is expected to set this by hand.
VITE_AGENTIC_DEMO=1

# Nothing else belongs here. Vite loads `.env.demo` *after* `.env.local`, so any knob declared in
# this file would override the one a developer set for themselves. The demo's knobs
# (VITE_DEMO_AGENTS, VITE_ACTION_DECIDER, VITE_DISABLE_MEMORY, VITE_SUPPRESS_IDLE_AFTER) and the
# proxy's credentials stay in `.env.local`, which this mode still loads.
