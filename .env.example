# Copy to `.env.local` (git-ignored) and fill in. The model proxy (`npm run proxy`, started by
# `npm run dev` / `play:local`) reads it from the repository root; Vite reads the `VITE_` names.
# Server-side names never reach the browser; `VITE_` names are bundled into the client, so never
# put a secret behind a `VITE_` prefix.

# ---------------------------------------------------------------------------------------------
# Required: chat + embedding endpoints (both OpenAI-compatible)
# ---------------------------------------------------------------------------------------------
LLM_API_URL=https://your-openai-compatible-endpoint
LLM_API_KEY=
LLM_MODEL=

# Embeddings are a separate axis and may point at another provider. The world stores 1024-dim
# vectors, so pick a model that returns 1024 dimensions (e.g. voyage-3.5-lite).
LLM_EMBEDDING_API_URL=https://api.voyageai.com
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=voyage-3.5-lite

# ---------------------------------------------------------------------------------------------
# Optional: chat endpoint quirks
# ---------------------------------------------------------------------------------------------
# Some gateways reject the `stop` parameter with a 400. The proxy detects this per model and falls
# back; `false` skips the probe and applies stop words locally from the start.
# LLM_SUPPORTS_STOP=false

# No embedding model? Skip memory. The proxy reads `DISABLE_MEMORY`, the client `VITE_DISABLE_MEMORY`,
# so set both.
# DISABLE_MEMORY=true
# VITE_DISABLE_MEMORY=true

# ---------------------------------------------------------------------------------------------
# Optional: Jev (typed System One decider, docs/12)
# ---------------------------------------------------------------------------------------------
# Only called when a decider below is set to `jev`.
# JEV_API_URL=https://api.typesafe.ai
# JEV_API_KEY=
# JEV_MODEL=jev-1.13.0

# Use Jev for the agents' action decision instead of the chat model.
# VITE_ACTION_DECIDER=jev
# Same, for the god's stage-one gate; its intervention stays on the chat model.
# VITE_GOD_GATE_DECIDER=jev

# ---------------------------------------------------------------------------------------------
# Optional: Langfuse tracing
# ---------------------------------------------------------------------------------------------
# Tracing turns on when both keys are set.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENVIRONMENT=default
# LANGFUSE_RELEASE=

# ---------------------------------------------------------------------------------------------
# Optional: storage (docs/11 §4)
# ---------------------------------------------------------------------------------------------
# Enables the proxy's /worlds routes and the per-world quota. Start the bundled database with
# `docker compose up -d postgres`.
# DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/remaining_time

# ---------------------------------------------------------------------------------------------
# Optional: spend limits
# ---------------------------------------------------------------------------------------------
# Model calls per proxy process lifetime; restart the proxy to reset. Default 2000.
# MODEL_PROXY_CALL_CAP=2000
# Model calls per player (per identity token) over a trailing window; needs DATABASE_URL. A local
# server has one player. Defaults 1000 per hour.
# MODEL_OWNER_QUOTA=1000
# MODEL_QUOTA_WINDOW_MS=3600000

# ---------------------------------------------------------------------------------------------
# Optional: hosted backend (docs/14)
# ---------------------------------------------------------------------------------------------
# Many anonymous players on one server: identity tokens are required, worlds belong to whoever
# created them, and the server chooses world ids. Unset, the server is the permissive local one.
# HOSTED=1
# Signs identity tokens. Required when HOSTED=1; changing it logs every player out of their worlds.
# IDENTITY_SECRET=
# Behind a load balancer: read the client address from X-Forwarded-For.
# TRUST_PROXY=1
# Hosted-only limits. Defaults shown.
# IDENTITY_MINT_LIMIT=20              # new identities per address per hour
# MODEL_ADDRESS_QUOTA=3000            # model calls per address per quota window
# MAX_WORLDS_PER_OWNER=20
# MAX_WORLD_DEFINITION_BYTES=1048576
# MAX_BATCH_BYTES=2097152
# Delete worlds with no batch in this many days. Off unless set.
# WORLD_IDLE_DAYS=30

# The client's server URLs. Unset, they are same-origin paths that Vite proxies to the server.
# `npm run play:remote` takes them from the committed `.env.remote` instead.
# VITE_MODEL_PROXY_URL=https://api.example.com/llm
# VITE_STORAGE_URL=https://api.example.com/worlds
# VITE_IDENTITY_URL=https://api.example.com/identity

# ---------------------------------------------------------------------------------------------
# Optional: agentic demo knobs (read only on the `feat/jev-demo-solarium` branch)
# ---------------------------------------------------------------------------------------------
# VITE_AGENTIC_DEMO=1
# Cast size, clamped to [1, 50]. Default 5.
# VITE_DEMO_AGENTS=5
# After n consecutive idles, the decider leans against another one.
# VITE_SUPPRESS_IDLE_AFTER=5

# ---------------------------------------------------------------------------------------------
# Alternative providers (instead of LLM_API_URL above)
# ---------------------------------------------------------------------------------------------
# Picked in this order: OPENAI_API_KEY, TOGETHER_API_KEY, LLM_API_URL, then a local Ollama. The
# proxy logs which one it chose on boot.
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
