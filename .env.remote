# `npm run play:remote`: this frontend against the hosted backend (docs/14 §4.2).
#
# Committed on purpose. These are public URLs: the browser sees them anyway, and nothing secret may
# ever sit behind a `VITE_` name. Vite still loads `.env.local` in this mode, but the values here
# take precedence over it.
VITE_MODEL_PROXY_URL=https://api.example.com/llm
VITE_STORAGE_URL=https://api.example.com/worlds
VITE_IDENTITY_URL=https://api.example.com/identity
