{
  "name": "ai-town",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "play:local": "vite --mode memory",
    "build:local": "vite build --mode memory",
    "prototype": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --outDir .prototype prototype/world.ts prototype/cli.ts && node .prototype/cli.js",
    "test:prototype": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/engine",
    "dev": "npm run play:local",
    "build": "tsc && vite build --mode memory",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "fmt:staged": "lint-staged",
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose",
    "level-editor": "vite src/editor/",
    "le": "vite src/editor/"
  },
  "dependencies": {
    "@pixi/react": "^7.1.0",
    "@pixi/sound": "^5.2.0",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "20.2.5",
    "@types/react": "18.2.8",
    "@types/react-dom": "18.2.4",
    "clsx": "^2.0.0",
    "eslint": "8.42.0",
    "pixi-viewport": "^5.0.1",
    "pixi.js": "^7.2.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-github-btn": "^1.4.0",
    "react-modal": "^3.16.1",
    "react-toastify": "^9.1.3",
    "typescript": "5.1.3",
    "update-browserslist-db": "^1.1.2",
    "uplot": "^1.6.25",
    "usehooks-ts": "^2.9.1"
  },
  "devDependencies": {
    "@types/css-font-loading-module": "^0.0.8",
    "@types/jest": "^29.5.4",
    "@types/react-modal": "^3.16.0",
    "@types/ws": "^8.5.5",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-react": "^4.0.4",
    "autoprefixer": "^10.4.15",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.4.28",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "vite": "^4.4.9"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "type": "module"
}
